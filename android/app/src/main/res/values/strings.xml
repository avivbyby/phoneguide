    <string name="sharing_notification">משתפים את המסך</string>

    <string name="overlay_title">צריך הרשאה אחת</string>
    <string name="overlay_explanation">כדי שהקרוב יוכל לסמן לך על המסך איפה ללחוץ, האפליקציה צריכה את ההרשאה «הצגה מעל אפליקציות אחרות». הקרוב רק מסמן — הוא לא יכול ללחוץ במקומך.</string>
    <string name="overlay_open_settings">לפתוח את ההגדרות</string>
    <string name="overlay_cancel">לא עכשיו</string>
    <string name="overlay_denied">בלי ההרשאה «הצגה מעל אפליקציות אחרות» אי אפשר להתחיל שיחה. אפשר ללחוץ שוב על «אני צריך עזרה» ולאשר בהגדרות.</string>

    <string name="error_connect">לא הצלחנו להתחבר לשרת. בודקים שיש אינטרנט ומנסים שוב.</string>
    <string name="error_rate_limited">היו יותר מדי ניסיונות. מחכים כמה דקות ומנסים שוב.</string>
    <string name="error_expired">הקוד כבר לא בתוקף. לוחצים שוב על «אני צריך עזרה» לקוד חדש.</string>
    <string name="error_generic">משהו השתבש. מנסים שוב.</string>

    <!-- Overlay banner while the helper sees the screen; «סיום» ends the call. -->
    <string name="sharing_banner">רואים את המסך</string>
